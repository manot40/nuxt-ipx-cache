{
  "type": "module",
  "name": "nuxt-ipx-cache",
  "license": "MIT",
  "version": "1.1.0",
  "description": "Cache ipx-optimized image to disk and save your cpu time!",
  "repository": "manot40/nuxt-ipx-cache",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "import": "./dist/module.mjs"
    }
  },
  "typesVersions": {
    "module": {
      "*": [
        "./dist/module.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && changelogen --release && npm publish --access=public && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "defu": "^6.1.4",
    "ohash": "^2.0.12",
    "unstorage": "^1.17.6"
  },
  "peerDependencies": {
    "@nuxt/kit": "^5.x || ^4.x",
    "ipx": "^4.x || ^3.x"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.6.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.1",
    "@nuxt/test-utils": "^4.3.3",
    "@types/node": "^24.19.2",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.5",
    "nuxt": "^4.6.1",
    "oxfmt": "^0.73.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
